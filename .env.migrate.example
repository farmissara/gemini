# Copy this file to .env.migrate.local and fill in credentials for the target project.
# Keep this file local. Never put the service role key in VITE_* variables or commit secrets.
SUPABASE_TARGET_URL=https://YOUR_NEW_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Copy the Session Pooler connection string from Supabase > Connect.
# Include the password in the URL only in this ignored local file; URL-encode special characters.
SUPABASE_DB_URL=
